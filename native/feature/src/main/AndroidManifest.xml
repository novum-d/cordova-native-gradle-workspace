<!-- ホストから明示的Intentで起動するCompose画面を、Debug・Release共通で登録する。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- NFCは通常権限。非搭載端末でもWeb機能を使えるよう、ハードウェアは必須にしない。 -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <application>
        <!-- 両ホストの起動時にTimberを初期化する。既存のStartup providerへmetadataを統合する。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false">
            <meta-data
                android:name="dev.example.nativefeature.logging.TimberInitializer"
                android:value="androidx.startup" />
        </provider>
        <!-- 同一アプリのホストだけが起動する。ランチャーはCordovaまたは開発用appで定義する。 -->
        <activity
            android:name="dev.example.nativefeature.MainActivity"
            android:exported="false" />
    </application>
</manifest>
