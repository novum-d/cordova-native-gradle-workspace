# npm依存とローカルに取得したツールは、管理元の設定から復元する。
node_modules/
/.tools/
npm-debug.log*

# Gradle・Kotlinのキャッシュ、各モジュールのビルド出力、マシン固有SDKパスを除外する。
.gradle/
.kotlin/
build/
local.properties

# Androidの外部ネイティブビルドで生成される作業ディレクトリを除外する。
.cxx/
.externalNativeBuild/

# Android Studioのローカルなプロジェクト情報。構成はGradleから再生成する。
.idea/
*.iml
*.ipr
*.iws

# Cordovaの再生成対象。管理元はconfig.xml・hook・native/gradle配下に置く。
/CordovaComposeApp/platforms/
/CordovaComposeApp/plugins/

# 検証用の生成物は専用ディレクトリに置き、docs/の管理済み検証記録は保持する。
/artifacts/

# JVMのクラッシュログ・ヒープダンプとmacOSのメタデータを除外する。
hs_err_pid*.log
replay_pid*.log
*.hprof
.DS_Store
._*
